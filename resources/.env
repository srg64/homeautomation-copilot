# 1000 ms -> 1 s
# SLEEP_BEFORE_IMPORT=1000  # 1s
# 10000 ms -> 10 s
SLEEP_BEFORE_IMPORT=10000  # 10s

# 5 * 60 * 1000 ms -> 300000ms -> 5 min
DURATION_OF_IMPORT_CYCLE=300000

# 60 * 1000 ms -> 60000ms -> 1 min
MAX_DURATION_OF_PROCESSING_CYCLE=60000
# 2 * 60 * 1000 ms -> 120000ms -> 2 min
SLEEP_BEFORE_NEXT_PROCESSING_CYCLE=120000

# 5 * 60 * 1000 ms -> 300000ms -> 5 min
TIMEOUT=300000
# 5 * 60 * 1000 ms -> 300000ms -> 5 min
API_TIMEOUT=300000
# The active .env file is in project root directory. 
# It is in .gitignore, so it is not tracked by git. 
# There are .env-example* files with placeholder values for secrets.
# These files are tracked by git and can be used as a reference for the required environment variables.

# Access information of the InfluxDB instance to read from
SOURCE_URL=http://enpal.fritz.box:8086
# SOURCE_URL=http://192.168.88.1:8086
# Viewer token
SOURCE_TOKEN=****************************************************************************************
# Internal token
# SOURCE_TOKEN=****************************************************************************************
SOURCE_ORG=enpal
SOURCE_BUCKET=solar

SOURCE_PATH=D:\enpal\
WORK_PATH=D:\enpal\work\
ARCHIVE_PATH=D:\enpal\archive\

# Access information of the InfluxDB instance to write to
TARGET_URL=http://homeautomation.fritz.box:8086
TARGET_TOKEN=****************************************************************************************
TARGET_ORG=homeautomation
# Productive bucket
# TARGET_BUCKET=solar
# Test bucket
TARGET_BUCKET=solar_test

# 1000 ms -> 1 s
# SLEEP_BEFORE_IMPORT=1000  # 1s
# 10000 ms -> 10 s
SLEEP_BEFORE_IMPORT=10000  # 10s

# 5 * 60 * 1000 ms -> 300000ms -> 5 min
DURATION_OF_IMPORT_CYCLE=300000  # 5 min

# 60 * 1000 ms -> 60000ms -> 1 min
MAX_DURATION_OF_PROCESSING_CYCLE=60000  # 1 min
# 2 * 60 * 1000 ms -> 120000ms -> 2 min
SLEEP_BEFORE_NEXT_PROCESSING_CYCLE=120000  # 2 min

# 5 * 60 * 1000 ms -> 300000ms -> 5 min
TIMEOUT=300000  # 5 min
# 5 * 60 * 1000 ms -> 300000ms -> 5 min
API_TIMEOUT=300000  # 5 min